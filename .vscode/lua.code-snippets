{
	"benchmark instructions": {
		"prefix": "benchmark-instructions",
		"body": [
			"local benchmark = avatar:getCurrentInstructions() -- START OF BENCHMARK",
			"${1:host:setActionbar(avatar:getCurrentInstructions()-benchmark-5) -- END OF BENCHMARK}"
		]
	},
	"benchmark time": {
		"prefix": "benchmark-miliseconds",
		"body": [
			"local benchmark = client:getSystemTime() -- START OF BENCHMARK",
			"${1:host:setActionbar(client:getSystemTime()-benchmark) -- END OF BENCHMARK}"
		]
	},
	"inheritance_fix": {
      "prefix": "generic",
      "body": [
         "---@generic self",
         "---@param self self",
         "---@return self",
         "---@cast self ${1}",
      ]
   },
	"pcall_setup": {
      "prefix": "pcall",
      "body": [
         "local ok, result = pcall(${1})",
         "if ok then",
         "\t${2}",
         "end",
      ]
   },
	"method_vec2": {
      "prefix": "vec2_method",
      "body": [
			"---@overload fun(self: self, x: number, y: number): self",
			"---@param x number",
			"---@param y number",
			"---@generic self",
			"---@param self self",
			"---@return self",
			"function ${1}:${2}(x,y)",
			"\t---@cast self ${1}",
			"\treturn self",
			"end",
      ]
   },
	"method_vec3": {
		"prefix": "vec3_method",
		"body": [
			"---@overload fun(self: self, x: number, y: number, z: number): self",
			"---@param x number",
			"---@param y number",
			"---@param z number",
			"---@generic self",
			"---@param self self",
			"---@return self",
			"function ${1}:${2}(x,y,z)",
			"\t---@cast self ${1}",
			"\treturn self",
			"end",
		]
	},
	"method_vec4": {
		"prefix": "vec4_method",
		"body": [
			"---@overload fun(self: self, x: number, y: number, z: number, w: number): self",
			"---@overload fun(self: self, xy: Vector2, zw: Vector2): self",
			"---@param x number",
			"---@param y number",
			"---@param z number",
			"---@param w number",
			"---@generic self",
			"---@param self self",
			"---@return self",
			"function ${1}:${2}(x,y,z,w)",
			"\t---@cast self ${1}",
			"\treturn self",
			"end",
		]
	},
}